# ローカル開発用の設定例（このファイルは秘密情報を含みません）
#
# 本番（Firebase Hosting）では、Hosting が自動で配信する /__/firebase/init.json から
# 設定を読み込むため、この .env は不要です。
#
# エミュレータで動かす場合： npm run dev:emulator（.env.emulator は自動生成不要・下記の値で動きます）
VITE_USE_EMULATORS=false
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
