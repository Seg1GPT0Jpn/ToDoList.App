    ]},
    { time: '🌙 夜・就寝前', items: [
      { text: '数学の問題集を解く', note: '木曜授業の2日前 → 青チャート例題 or サクシード 1〜2問', tag: 't-math', label: '数学' },
      { text: '英単語を軽く見る（1周目）', note: 'LEAP 501-1100、流し見でOK。負担をかけない', tag: 't-en', label: '英語' },
