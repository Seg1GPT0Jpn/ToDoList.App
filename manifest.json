      { text: '指揮の振り方を練習する（10〜15分）', note: '鏡の前でじっくり', tag: 't-music', label: '学指揮' },
    ]},
  ],
  sun: [
    { time: '🌅 朝', items: [
      { text: '漢字を5〜10問解く', note: '現代の国語 P.12-15, 66-113 から少量ずつ', tag: 't-jp', label: '国語' },
      { text: '古文単語を5〜10語確認', note: 'P.74-156、毎日少量が最重要', tag: 't-jp', label: '国語' },
    ]},
    { time: '🌙 夜 22:00〜23:00', items: [
      { text: '英単語を重点的に覚える（3日目・仕上げ）', note: '明日の月曜ECに向けて最終確認', tag: 't-en', label: '英語' },
      { text: '一週間の提出物の進捗を確認する', note: '遅れているものを把握して翌週に備える', tag: 't-all', label: '全教科' },
      { text: '楽典 or 指揮法教程を読む（長めに）', note: '週末は1章分などまとめて読む', tag: 't-music', label: '学指揮' },
