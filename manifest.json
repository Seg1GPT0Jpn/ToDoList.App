// Storage helpers
function todayStr() {
  const d = new Date();
  return `${d.getFullYear()}-${d.getMonth()+1}-${d.getDate()}`;
}
function loadState() {
  try { return JSON.parse(localStorage.getItem('routine_state') || '{}'); } catch { return {}; }
}
function saveState(s) { localStorage.setItem('routine_state', JSON.stringify(s)); }
function loadStreak() { return parseInt(localStorage.getItem('routine_streak') || '0'); }
function saveStreak(n) { localStorage.setItem('routine_streak', n); }
function loadLastComplete() { return localStorage.getItem('routine_last_complete') || ''; }
function saveLastComplete(d) { localStorage.setItem('routine_last_complete', d); }

let state = loadState();
let currentDay = DAY_KEYS[new Date().getDay()];

function getChecked(dayKey) {
  return state[dayKey] || {};
}
function setChecked(dayKey, idx, val) {
  if (!state[dayKey]) state[dayKey] = {};
  state[dayKey][idx] = val;
  saveState(state);
}

function allTasks(dayKey) {
  return TASKS[dayKey].flatMap(s => s.items);
}
function doneCount(dayKey) {
  const checked = getChecked(dayKey);
  return Object.values(checked).filter(Boolean).length;
}
function totalCount(dayKey) { return allTasks(dayKey).length; }

function renderTabs() {
  const tabs = document.getElementById('day-tabs');
  const todayIdx = new Date().getDay();
  tabs.innerHTML = '';
  DAY_KEYS.forEach((key, i) => {
    const div = document.createElement('div');
    div.className = 'tab' +
      (key === currentDay ? ' active' : '') +
      (i === todayIdx ? ' is-today' : '') +
      (doneCount(key) > 0 ? ' has-done' : '');
    div.innerHTML = `<span class="day-name">${DAYS[i]}</span><div class="day-dot"></div>`;
    div.onclick = () => { currentDay = key; render(); };
    tabs.appendChild(div);
  });
}

function renderTasks() {
  const list = document.getElementById('task-list');
  const checked = getChecked(currentDay);
  const sections = TASKS[currentDay];
  let idx = 0;
  let html = '';
  sections.forEach(section => {
    html += `<div class="time-section"><div class="time-label">${section.time}</div>`;
    section.items.forEach(item => {
      const i = idx++;
      const done = !!checked[i];
      html += `<div class="task${done?' done':''}" onclick="toggleTask(${i})" data-idx="${i}">
        <div class="check"><svg width="12" height="9" viewBox="0 0 12 9" fill="none"><path d="M1 4L4.5 7.5L11 1" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <div class="task-body">
          <div class="task-text">${item.text}</div>
          ${item.note ? `<div class="task-note">${item.note}</div>` : ''}
        </div>
        <span class="tag ${item.tag}">${item.label}</span>
      </div>`;
    });
    html += '</div>';
  });
  list.innerHTML = html;
}

function renderProgress() {
  const done = doneCount(currentDay);
  const total = totalCount(currentDay);
  const pct = total ? Math.round(done / total * 100) : 0;
  document.getElementById('prog-fill').style.width = pct + '%';
  document.getElementById('prog-count').textContent = `${done} / ${total}`;

  // Streak
  if (done === total && total > 0) {
    const today = todayStr();
    if (loadLastComplete() !== today) {
      saveLastComplete(today);
      saveStreak(loadStreak() + 1);
    }
  }
  document.getElementById('streak-count').textContent = loadStreak();
}

function renderDate() {
  const d = new Date();
  const label = `${d.getMonth()+1}/${d.getDate()}（${DAYS[d.getDay()]}）`;
  document.getElementById('date-label').textContent = label;
}

function toggleTask(idx) {
  const checked = getChecked(currentDay);
  checked[idx] = !checked[idx];
  state[currentDay] = checked;
  saveState(state);
  renderTasks();
  renderProgress();
  renderTabs();
}

function resetDay() {
  state[currentDay] = {};
  saveState(state);
  render();
}

function render() {
  renderDate();
  renderTabs();
  renderTasks();
  renderProgress();
}

render();

// Auto-switch to today on date change
setInterval(() => {
  const newDay = DAY_KEYS[new Date().getDay()];
  if (newDay !== DAY_KEYS[new Date().getDay()]) render();
}, 60000);
</script>

<!-- PWA Service Worker -->
<script>
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('sw.js');
}
</script>
</body>
</html>
