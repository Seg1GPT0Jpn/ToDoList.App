      { text: '楽典 or 指揮法教程を少し読む', note: '1〜2ページでもOK', tag: 't-music', label: '学指揮' },
      { text: '指揮の振り方を練習する（5〜10分）', note: '鏡の前で2・3・4拍子の基本パターン', tag: 't-music', label: '学指揮' },
    ]},
  ],
  wed: [
    { time: '🌅 朝・登校前', items: [
      { text: '漢字を5〜10問解く', note: '現代の国語 P.12-15, 66-113 から少量ずつ', tag: 't-jp', label: '国語' },
      { text: '古文単語を5〜10語確認', note: 'P.74-156、毎日少量が最重要', tag: 't-jp', label: '国語' },
    ]},
