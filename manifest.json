<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#1a1a2e">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="日課">
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icons/icon-192.png">
<title>日課ルーティン</title>
<style>
  :root {
    --bg: #0f0f1a;
    --bg2: #1a1a2e;
    --bg3: #16213e;
    --card: #1e1e32;
    --border: rgba(255,255,255,0.08);
    --text: #f0f0f5;
    --muted: rgba(240,240,245,0.45);
    --hint: rgba(240,240,245,0.25);
    --accent: #7c6ee0;
    --accent-light: rgba(124,110,224,0.15);
    --accent-border: rgba(124,110,224,0.35);
    --study: #4a9eff;
    --study-bg: rgba(74,158,255,0.12);
    --math: #ff6b7a;
    --math-bg: rgba(255,107,122,0.12);
    --music: #ffb347;
    --music-bg: rgba(255,179,71,0.12);
    --en: #4ecb8d;
    --en-bg: rgba(78,203,141,0.12);
    --done-opacity: 0.35;
    --radius: 12px;
    --radius-sm: 8px;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
  html, body { height: 100%; background: var(--bg); color: var(--text); font-family: -apple-system, 'Helvetica Neue', sans-serif; overscroll-behavior: none; }

  /* Layout */
  .app { display: flex; flex-direction: column; height: 100dvh; max-width: 480px; margin: 0 auto; }

  /* Header */
  header { padding: 56px 20px 12px; background: var(--bg2); border-bottom: 0.5px solid var(--border); flex-shrink: 0; }
  .header-top { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 12px; }
  h1 { font-size: 22px; font-weight: 700; letter-spacing: -0.5px; }
  .date-label { font-size: 13px; color: var(--muted); }
  .progress-wrap { display: flex; align-items: center; gap: 10px; }
  .progress-bar { flex: 1; height: 3px; background: var(--border); border-radius: 2px; overflow: hidden; }
  .progress-fill { height: 100%; background: var(--accent); border-radius: 2px; transition: width 0.4s cubic-bezier(.4,0,.2,1); }
  .progress-count { font-size: 12px; color: var(--muted); min-width: 40px; text-align: right; }

  /* Day tabs */
  .day-tabs { display: flex; gap: 4px; padding: 12px 20px; background: var(--bg2); overflow-x: auto; scrollbar-width: none; flex-shrink: 0; border-bottom: 0.5px solid var(--border); }
  .day-tabs::-webkit-scrollbar { display: none; }
  .tab { flex-shrink: 0; display: flex; flex-direction: column; align-items: center; padding: 8px 10px; border-radius: var(--radius-sm); cursor: pointer; border: 0.5px solid transparent; transition: all 0.2s; min-width: 44px; }
  .tab .day-name { font-size: 12px; font-weight: 600; color: var(--muted); }
  .tab .day-dot { width: 5px; height: 5px; border-radius: 50%; background: transparent; margin-top: 4px; transition: background 0.2s; }
  .tab.has-done .day-dot { background: var(--accent); opacity: 0.5; }
  .tab.active { background: var(--accent-light); border-color: var(--accent-border); }
  .tab.active .day-name { color: var(--accent); }
  .tab.is-today .day-name { color: var(--text); }
  .tab.is-today.active .day-name { color: var(--accent); }

  /* Task list */
  .task-list { flex: 1; overflow-y: auto; padding: 16px 20px 32px; scroll-behavior: smooth; }
  .task-list::-webkit-scrollbar { display: none; }

  .time-section { margin-bottom: 20px; }
  .time-label { font-size: 11px; font-weight: 600; color: var(--muted); letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 8px; display: flex; align-items: center; gap: 6px; }
  .time-label::after { content: ''; flex: 1; height: 0.5px; background: var(--border); }

  .task { display: flex; align-items: flex-start; gap: 12px; padding: 13px 14px; background: var(--card); border: 0.5px solid var(--border); border-radius: var(--radius); margin-bottom: 6px; cursor: pointer; transition: opacity 0.25s, transform 0.1s; active-transform: scale(0.98); user-select: none; }
  .task:active { transform: scale(0.98); }
  .task.done { opacity: var(--done-opacity); }

  .check { width: 22px; height: 22px; border-radius: 50%; border: 1.5px solid rgba(255,255,255,0.2); flex-shrink: 0; margin-top: 1px; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
  .task.done .check { background: var(--accent); border-color: var(--accent); }
  .check svg { display: none; }
  .task.done .check svg { display: block; }

  .task-body { flex: 1; min-width: 0; }
  .task-text { font-size: 14px; line-height: 1.45; font-weight: 500; }
  .task.done .task-text { text-decoration: line-through; }
  .task-note { font-size: 12px; color: var(--muted); margin-top: 3px; line-height: 1.4; }

  .tag { font-size: 10px; font-weight: 600; padding: 3px 8px; border-radius: 20px; flex-shrink: 0; align-self: flex-start; margin-top: 2px; letter-spacing: 0.03em; }
  .t-jp  { color: var(--study); background: var(--study-bg); }
  .t-math { color: var(--math); background: var(--math-bg); }
  .t-music { color: var(--music); background: var(--music-bg); }
  .t-en  { color: var(--en); background: var(--en-bg); }
  .t-all { color: var(--muted); background: rgba(255,255,255,0.06); }

  /* Bottom bar */
  .bottom-bar { padding: 12px 20px; padding-bottom: calc(12px + env(safe-area-inset-bottom)); background: var(--bg2); border-top: 0.5px solid var(--border); flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; }
  .streak { font-size: 13px; color: var(--muted); }
  .streak span { color: var(--accent); font-weight: 700; }
  .reset-btn { font-size: 12px; color: var(--muted); background: none; border: 0.5px solid var(--border); padding: 6px 14px; border-radius: 20px; cursor: pointer; }
  .reset-btn:active { background: var(--card); }

  /* All done banner */
  .all-done { display: none; flex-direction: column; align-items: center; justify-content: center; padding: 40px 20px; text-align: center; }
  .all-done.show { display: flex; }
  .all-done-emoji { font-size: 48px; margin-bottom: 16px; }
  .all-done-title { font-size: 20px; font-weight: 700; margin-bottom: 8px; }
  .all-done-sub { font-size: 14px; color: var(--muted); line-height: 1.6; }
</style>
</head>
<body>
<div class="app">
  <header>
    <div class="header-top">
      <h1>日課ルーティン</h1>
      <span class="date-label" id="date-label"></span>
    </div>
    <div class="progress-wrap">
      <div class="progress-bar"><div class="progress-fill" id="prog-fill" style="width:0%"></div></div>
      <span class="progress-count" id="prog-count">0 / 0</span>
    </div>
  </header>

  <div class="day-tabs" id="day-tabs"></div>

  <div class="task-list" id="task-list"></div>

  <div class="bottom-bar">
    <div class="streak">連続達成 <span id="streak-count">0</span> 日</div>
    <button class="reset-btn" onclick="resetDay()">この日をリセット</button>
  </div>
</div>

<script>
