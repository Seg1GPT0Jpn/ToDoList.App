      { text: '英単語を軽く見る（2周目）', note: '火曜に見たものを再確認。2日で2周完了', tag: 't-en', label: '英語' },
      { text: '提出物を少し進める', note: 'サクシード・Z会ワーク・beワークなど', tag: 't-all', label: '全教科' },
      { text: 'その日の授業を5分で見直す', note: '理科・社会の暗記系は当日復習が効果的', tag: 't-all', label: '全教科' },
      { text: '楽典 or 指揮法教程を少し読む', note: '1〜2ページでもOK', tag: 't-music', label: '学指揮' },
      { text: '指揮の振り方を練習する（5〜10分）', note: '鏡の前で2・3・4拍子の基本パターン', tag: 't-music', label: '学指揮' },
    ]},
  ],
  thu: [
    { time: '🌅 朝・登校前', items: [
      { text: '漢字を5〜10問解く', note: '現代の国語 P.12-15, 66-113 から少量ずつ', tag: 't-jp', label: '国語' },
      { text: '古文単語を5〜10語確認', note: 'P.74-156、毎日少量が最重要', tag: 't-jp', label: '国語' },
    ]},
    { time: '🌙 夜・就寝前', items: [
      { text: '英語の問題集を解く', note: '土曜授業の2日前 → beワーク or Scramble 1〜2問', tag: 't-en', label: '英語' },
      { text: '提出物を少し進める', note: 'サクシード・Z会ワーク・beワークなど', tag: 't-all', label: '全教科' },
      { text: 'その日の授業を5分で見直す', note: '理科・社会の暗記系は当日復習が効果的', tag: 't-all', label: '全教科' },
      { text: '楽典 or 指揮法教程を少し読む', note: '1〜2ページでもOK', tag: 't-music', label: '学指揮' },
      { text: '指揮の振り方を練習する（5〜10分）', note: '鏡の前で2・3・4拍子の基本パターン', tag: 't-music', label: '学指揮' },
    ]},
  ],
  fri: [
    { time: '🌅 朝・登校前', items: [
      { text: '漢字を5〜10問解く', note: '現代の国語 P.12-15, 66-113 から少量ずつ', tag: 't-jp', label: '国語' },
