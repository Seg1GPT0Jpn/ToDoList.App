  "version": 1,
  "questions": [
    {
      "id": "mat_stat01_001",
      "unit": "math.m1.data.stats.center",
      "category": "knowledge",
      "prompt": "データを小さい順に並べたとき、中央値と同じ値になる四分位数は？",
      "choices": [
        "第1四分位数（Q₁）",
        "第2四分位数（Q₂）",
        "第3四分位数（Q₃）",
        "四分位範囲"
      ],
      "answerIndex": 1,
      "explanation": "中央値（メジアン）はデータを二等分する位置であり、第2四分位数と一致します。"
    },
    {
      "id": "mat_stat01_002",
      "unit": "math.m1.data.stats.spread",
      "category": "knowledge",
      "prompt": "四分位範囲（IQR）の定義として正しい式は？",
      "choices": [
        "Q₃ - Q₂",
        "Q₂ - Q₁",
        "Q₃ - Q₁",
        "(Q₃ - Q₁)/2"
      ],
      "answerIndex": 2,
      "explanation": "四分位範囲は第3四分位数と第1四分位数の差（Q₃ - Q₁）です。"
    },
    {
      "id": "mat_stat01_003",
      "unit": "math.m1.data.stats.spread",
      "category": "knowledge",
      "prompt": "四分位偏差の定義として正しい式は？",
      "choices": [
        "(Q₃ - Q₁)/2",
        "Q₃ - Q₁",
        "Q₂ - Q₁",
        "(Q₃ + Q₁)/2"
      ],
      "answerIndex": 0,
      "explanation": "四分位範囲の半分、すなわち (Q₃ - Q₁)/2 を四分位偏差と呼びます。"
    },
    {
      "id": "mat_stat01_004",
      "unit": "math.m1.data.stats.spread",
      "category": "calculation",
      "prompt": "データ 3, 5, 8, 12, 15 の第1四分位数（Q₁）は？",
      "choices": [
        "3",
        "4",
        "5",
        "8"
      ],
      "answerIndex": 1,
      "explanation": "中央値は 8。下位グループ（3, 5）の中央値は (3+5)/2 = 4 です。"
    },
    {
      "id": "mat_stat01_005",
      "unit": "math.m1.data.stats.spread",
      "category": "calculation",
      "prompt": "データ 3, 5, 8, 12, 15 の第3四分位数（Q₃）は？",
      "choices": [
        "12",
        "13.5",
        "15",
        "14"
      ],
      "answerIndex": 1,
      "explanation": "上位グループ（12, 15）の中央値は (12+15)/2 = 13.5 です。"
    },
    {
      "id": "mat_stat01_006",
      "unit": "math.m1.data.stats.spread",
      "category": "calculation",
      "prompt": "データ 2, 4, 6, 8, 10, 12 の四分位範囲は？",
      "choices": [
        "4",
        "6",
        "8",
        "10"
      ],
      "answerIndex": 1,
      "explanation": "Q₁=4, Q₃=10 なので、四分位範囲は 10 - 4 = 6。"
    },
    {
      "id": "mat_stat01_007",
      "unit": "math.m1.data.stats.spread",
      "category": "thinking",
      "prompt": "箱ひげ図の「箱」の長さが表している統計量は？",
      "choices": [
        "範囲（レンジ）",
        "標準偏差",
        "四分位範囲",
        "平均値"
      ],
      "answerIndex": 2,
      "explanation": "箱の左端は Q₁、右端は Q₃ であり、箱の長さは四分位範囲（Q₃ - Q₁）を示します。"
    },
    {
      "id": "mat_stat01_008",
      "unit": "math.m1.data.stats.spread",
      "category": "thinking",
      "prompt": "箱ひげ図の箱の中に含まれるデータのおよその割合は？",
      "choices": [
        "約25%",
        "約50%",
        "約75%",
        "約100%"
      ],
      "answerIndex": 1,
      "explanation": "Q₁ から Q₃ の間には、全データの約50%（中央の半分）が含まれます。"
    },
    {
      "id": "mat_stat01_009",
      "unit": "math.m1.data.stats.center",
      "category": "knowledge",
      "prompt": "各データの値から平均値を引いた差を何という？",
      "choices": [
        "分散",
        "偏差",
        "標準偏差",
        "残差平方和"
      ],
      "answerIndex": 1,
      "explanation": "変量 x の各値から平均値 x̄ を引いた値（x - x̄）を偏差といいます。"
    },
    {
      "id": "mat_stat01_010",
      "unit": "math.m1.data.stats",
      "category": "knowledge",
      "prompt": "すべてのデータの「偏差の合計」は必ずいくつになる？",
      "choices": [
        "0",
        "1",
        "データ数 n",
        "分散の値"
      ],
      "answerIndex": 0,
      "explanation": "偏差の総和は常に 0 になります（Σ (xi - x̄) = 0）。"
    },
    {
      "id": "mat_stat01_011",
      "unit": "math.m1.data.stats.variance",
      "category": "knowledge",
      "prompt": "分散の定義として正しいものは？",
      "choices": [
        "偏差の絶対値の平均値",
        "偏差の2乗の平均値",
        "データの2乗の平均値",
        "偏差の平均値"
      ],
      "answerIndex": 1,
      "explanation": "偏差を2乗した値の平均値を分散（Variance）といいます。"
    },
    {
      "id": "mat_stat01_012",
      "unit": "math.m1.data.stats.variance",
      "category": "calculation",
      "prompt": "データ 2, 4, 6 の分散は？",
      "choices": [
        "2",
        "8/3",
        "4",
        "16/3"
      ],
      "answerIndex": 1,
      "explanation": "平均は 4。偏差は -2, 0, 2。偏差の2乗は 4, 0, 4。平均は (4+0+4)/3 = 8/3。"
    },
    {
      "id": "mat_stat01_013",
      "unit": "math.m1.data.stats.variance",
      "category": "calculation",
      "prompt": "データ 3, 3, 3, 3, 3 の標準偏差は？",
      "choices": [
        "0",
        "1",
        "3",
        "9"
      ],
      "answerIndex": 0,
      "explanation": "すべての値が等しい場合、ばらつきがないため偏差・分散・標準偏差はすべて 0 です。"
    },
    {
      "id": "mat_stat01_014",
      "unit": "math.m1.data.stats.variance",
      "category": "knowledge",
      "prompt": "分散 s² と標準偏差 s の関係として正しい式は？",
      "choices": [
        "s = (s²)²",
        "s = √(s²)",
        "s = s² / 2",
        "s = 2s²"
      ],
      "answerIndex": 1,
      "explanation": "標準偏差は分散の正の平方根です。"
    },
    {
      "id": "mat_stat01_015",
      "unit": "math.m1.data.stats.variance",
      "category": "calculation",
      "prompt": "あるテストの分散が 25 のとき、標準偏差は？",
      "choices": [
        "2.5",
        "5",
        "12.5",
        "625"
      ],
      "answerIndex": 1,
      "explanation": "√25 = 5 点。単位も元の変量と同じになります。"
    },
    {
      "id": "mat_stat01_016",
      "unit": "math.m1.data.stats.variance",
      "category": "calculation",
      "prompt": "公式「分散 ＝ (2乗の平均) − (平均の2乗)」を用いて、2乗の平均が 34、平均が 5 のデータの分散は？",
      "choices": [
        "4",
        "9",
        "14",
        "19"
      ],
      "answerIndex": 1,
      "explanation": "s² = ‾(x²) - (x̄)² = 34 - 5² = 34 - 25 = 9。"
    },
    {
      "id": "mat_stat01_017",
      "unit": "math.m1.data.stats.variance",
      "category": "thinking",
      "prompt": "全員の得点に一律 10 点を加えたとき、得点の標準偏差はどうなる？",
      "choices": [
        "10 増える",
        "√10 増える",
        "変わらない",
        "10 倍になる"
      ],
      "answerIndex": 2,
      "explanation": "全データに定数を加えても散らばり具合（ばらつき）は変化しません。"
    },
    {
      "id": "mat_stat01_018",
      "unit": "math.m1.data.stats.variance",
      "category": "thinking",
      "prompt": "全員の得点を 2 倍にしたとき、得点の分散はどうなる？",
      "choices": [
        "2倍になる",
        "4倍になる",
        "変わらない",
        "√2倍になる"
      ],
      "answerIndex": 1,
      "explanation": "変量を a 倍すると、分散は a² 倍（2²=4倍）になります。"
    },
    {
      "id": "mat_stat01_019",
      "unit": "math.m1.data.stats.variance",
      "category": "thinking",
      "prompt": "全員の得点を 3 倍にしたとき、得点の標準偏差はどうなる？",
      "choices": [
        "3倍になる",
        "9倍になる",
        "変わらない",
        "√3倍になる"
      ],
      "answerIndex": 0,
      "explanation": "変量を a 倍すると、標準偏差は |a| 倍になる。したがって 3 倍。"
    },
    {
      "id": "mat_stat01_020",
      "unit": "math.m1.data.stats.variance",
      "category": "knowledge",
      "prompt": "2つの変量 x, y の共分散の定義は？",
      "choices": [
        "x の分散と y の分散の積",
        "x の偏差と y の偏差の積の平均",
        "x と y の積の平均",
        "x の標準偏差と y の標準偏差の比"
      ],
      "answerIndex": 1,
      "explanation": "共分散 sxy = 1/nΣ (xi - x̄)(yi - ȳ) です。"
    },
    {
      "id": "mat_stat01_021",
      "unit": "math.m1.data.stats.correlation",
      "category": "knowledge",
      "prompt": "相関係数 r の取りうる値の範囲は？",
      "choices": [
        "0 ≦ r ≦ 1",
        "-1 ≦ r ≦ 1",
        "-1 < r < 1",
        "-∞ < r < ∞"
      ],
      "answerIndex": 1,
      "explanation": "相関係数は必ず -1 以上 1 以下の値をとります。"
    },
    {
      "id": "mat_stat01_022",
      "unit": "math.m1.data.stats.correlation",
      "category": "knowledge",
      "prompt": "相関係数の定義式として正しいものは？",
      "choices": [
